pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// {{name}} in the bloom style: Material You tones, rounding, spacing, fonts, sizes and motion
// for every part. Generated by `facet theme` from themes/<theme>.json; edit
// templates/bloom/.config/quickshell/config/Theme.qml instead. Quickshell reloads on its own
// when the file changes. Sizes are pixels at 1080p. CONTRACT.md lists what each token is for.
Singleton {
    id: root

    readonly property string name: "{{name}}"
    readonly property string themeId: "{{id}}"

    // ── Color helpers ────────────────────────────────────────

    // a with t (0..1) of b mixed in
    function mix(a, b, t) {
        return Qt.rgba(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, a.a + (b.a - a.a) * t);
    }

    function alpha(c, a) {
        return Qt.rgba(c.r, c.g, c.b, a);
    }

    // ── Material You tones ───────────────────────────────────

    // The theme's own ("tones" in themes/<theme>.json; facet derives the ones a theme lacks
    // from its colors)
    readonly property var fixedTones: ({
        surface: "{{tones.surface}}",
        container: "{{tones.container}}",
        high: "{{tones.high}}",
        highest: "{{tones.highest}}",
        primary: "{{tones.primary}}",
        onPrimary: "{{tones.onPrimary}}",
        primaryContainer: "{{tones.primaryContainer}}",
        onPrimaryContainer: "{{tones.onPrimaryContainer}}",
        secondary: "{{tones.secondary}}",
        secondaryContainer: "{{tones.secondaryContainer}}",
        tertiary: "{{tones.tertiary}}",
        text: "{{tones.text}}",
        dim: "{{tones.dim}}",
        outline: "{{tones.outline}}",
        page: "{{tones.page}}",
        ok: "{{tones.ok}}",
        okContainer: "{{tones.okContainer}}",
        error: "{{tones.error}}",
        errorContainer: "{{tones.errorContainer}}"
    })

    // Hook for colors from the wallpaper (Config.colorMode "dynamic"): a generator writes the
    // same keys to dynamicFile as { "tones": { ... } }; whatever it leaves out stays the
    // theme's. Without the file the theme's tones are used, so "dynamic" is safe to pick early.
    readonly property string dynamicFile: `${Quickshell.env("XDG_STATE_HOME") || Quickshell.env("HOME") + "/.local/state"}/facet/bloom-dynamic.json`
    property var dynamicTones: null
    readonly property bool dynamic: Config.colorMode === "dynamic" && dynamicTones !== null
    readonly property var tones: dynamic ? Object.assign({}, fixedTones, dynamicTones) : fixedTones

    FileView {
        path: Config.colorMode === "dynamic" ? root.dynamicFile : ""
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        onLoaded: {
            try {
                const parsed = JSON.parse(text());
                root.dynamicTones = parsed && typeof parsed.tones === "object" ? parsed.tones : null;
            } catch (e) {
                root.dynamicTones = null;
            }
        }
        onLoadFailed: root.dynamicTones = null
    }

    // Darkest first: page (behind everything, the lockscreen), surface (the frame, the bar,
    // drawers, windows), container (cards, pills on the surface), high (controls on a card,
    // hover), highest (hover on high, menus)
    readonly property color page: tones.page
    readonly property color surface: tones.surface
    readonly property color container: tones.container
    readonly property color high: tones.high
    readonly property color highest: tones.highest
    // The accent and what sits on it; primaryContainer for selected tabs and segments
    readonly property color primary: tones.primary
    readonly property color textOnPrimary: tones.onPrimary
    readonly property color primaryContainer: tones.primaryContainer
    readonly property color textOnPrimaryContainer: tones.onPrimaryContainer
    readonly property color secondary: tones.secondary
    // Selected list rows, chips and nav entries
    readonly property color secondaryContainer: tones.secondaryContainer
    // Dots, badges, weather, the odd highlight
    readonly property color tertiary: tones.tertiary
    readonly property color text: tones.text
    readonly property color dim: tones.dim
    readonly property color outline: tones.outline
    readonly property color ok: tones.ok
    readonly property color okContainer: tones.okContainer
    readonly property color textOnOk: "#0b2814"
    readonly property color error: tones.error
    readonly property color errorContainer: tones.errorContainer
    readonly property color textOnErrorContainer: "#ffdad6"
    readonly property color warn: "{{colors.warn}}"

    // Hover and press washes over anything (state layers)
    readonly property color hover: alpha(text, 0.08)
    readonly property color press: alpha(text, 0.12)
    // In a game: see-through pills over the picture, white text on them
    readonly property color scrim: Qt.rgba(8 / 255, 8 / 255, 12 / 255, 0.55)
    readonly property color textOnScrim: "#ffffff"
    readonly property color shadowColor: Qt.rgba(0, 0, 0, 0.55)

    // ── tui names, for core (services/Editor.qml) and copied tui code ──
    // New bloom code uses the Material names above.
    readonly property color bg: page
    readonly property color surface2: high
    readonly property color shadow: "#000000"
    readonly property color accent: tertiary
    readonly property color textDim: dim
    readonly property color muted: mix(dim, surface, 0.35)
    readonly property color border: outline
    readonly property color danger: error

    // ── Fonts ────────────────────────────────────────────────

    // Rubik for text (ttf-rubik-vf), Material Symbols Rounded for icons by name
    // (ttf-material-symbols-variable); the mono one comes from the theme
    readonly property string font: "Rubik"
    readonly property string iconFont: "Material Symbols Rounded"
    readonly property string mono: "{{fonts.mono}}"

    readonly property QtObject size: QtObject {
        readonly property int tiny: 12
        readonly property int small: 13
        readonly property int normal: 15
        readonly property int medium: 17
        readonly property int large: 22
        readonly property int title: 30
        readonly property int display: 44
        readonly property int clock: 210
    }

    readonly property QtObject icon: QtObject {
        readonly property int small: 18
        readonly property int normal: 21
        readonly property int large: 24
        readonly property int huge: 54
    }

    // ── Shape ────────────────────────────────────────────────

    // Config.corners: small, round (the mockup) or veryRound
    readonly property real cornerScale: Config.corners === "small" ? 0.55 : Config.corners === "veryRound" ? 1.3 : 1

    readonly property QtObject rounding: QtObject {
        readonly property int small: Math.round(10 * root.cornerScale)
        readonly property int normal: Math.round(14 * root.cornerScale)
        readonly property int medium: Math.round(18 * root.cornerScale)
        readonly property int large: Math.round(22 * root.cornerScale)
        // A drawer's free corners
        readonly property int drawer: Math.round(28 * root.cornerScale)
        // The desktop hole's corners and the concave joints of drawers
        readonly property int hole: Math.round(26 * root.cornerScale)
        readonly property int fillet: Math.round(26 * root.cornerScale)
        // Anything fully round: use height / 2, this is only a cap
        readonly property int full: 999
    }

    readonly property QtObject spacing: QtObject {
        readonly property int tiny: 2
        readonly property int small: 4
        readonly property int normal: 8
        readonly property int medium: 12
        readonly property int large: 16
        readonly property int huge: 24
    }

    readonly property QtObject padding: QtObject {
        readonly property int small: 8
        readonly property int normal: 12
        readonly property int card: 16
        readonly property int drawer: 18
    }

    // The frame around each screen: the bar is its top edge
    readonly property QtObject facet: QtObject {
        readonly property int bar: 52
        readonly property int border: 10
    }

    readonly property QtObject control: QtObject {
        // Pills in the bar (clock, tray, status)
        readonly property int pill: 34
        readonly property int iconButton: 36
        readonly property int button: 40
        readonly property int chip: 32
        readonly property int field: 54
        readonly property int slider: 48
        readonly property int sliderThin: 10
        readonly property int switchWidth: 52
        readonly property int switchHeight: 32
        readonly property int appIcon: 40
    }

    // ── Motion ───────────────────────────────────────────────

    // Config.animations: full, calm (no overshoot) or off; the desktop's own switch
    // (gsettings enable-animations false) counts as off too
    property bool systemReduced: false
    readonly property string motion: Config.animations === "off" || systemReduced ? "off" : Config.animations === "calm" ? "calm" : "full"
    readonly property bool animated: motion !== "off"
    readonly property real speed: animated ? 1 : 0

    Process {
        running: true
        command: ["gsettings", "get", "org.gnome.desktop.interface", "enable-animations"]
        stdout: StdioCollector {
            onStreamFinished: root.systemReduced = this.text.trim() === "false"
        }
    }

    readonly property QtObject anim: QtObject {
        // tui names (core and copied tui code)
        readonly property int fast: Math.round(200 * root.speed)
        readonly property int normal: Math.round(450 * root.speed)
        readonly property int slow: Math.round(900 * root.speed)
        // Hover, colors of a control
        readonly property int small: Math.round(250 * root.speed)
        // Content fading in, a tab switching
        readonly property int medium: Math.round(400 * root.speed)
        // Switches, buttons, chips (with curve.spring)
        readonly property int spring: Math.round(450 * root.speed)
        // Drawers sliding out of the frame and back
        readonly property int drawerIn: Math.round(550 * root.speed)
        readonly property int drawerOut: Math.round(450 * root.speed)
        // A palette change fading over
        readonly property int color: Math.round(600 * root.speed)
    }

    // Easing.BezierSpline curves: [c1x, c1y, c2x, c2y, end x, end y, ...]
    readonly property QtObject curve: QtObject {
        // Fast start, soft end: drawers and anything that arrives
        readonly property var emphasizedDecel: [0.05, 0.7, 0.1, 1, 1, 1]
        // Slow start, fast end: what leaves for good
        readonly property var emphasizedAccel: [0.3, 0, 0.8, 0.15, 1, 1]
        readonly property var standard: [0.2, 0, 0, 1, 1, 1]
        // A little overshoot for small things; calm swaps it for the soft one
        readonly property var spring: root.motion === "full" ? [0.34, 1.5, 0.64, 1, 1, 1] : [0.05, 0.7, 0.1, 1, 1, 1]
    }
}
