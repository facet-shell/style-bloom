# facet boot splash in the bloom style ({{name}}). Generated by `facet theme`; edit
# templates/plymouth/facet/facet.script instead. `facet boot` installs it with
# the pictures images.sh draws in the same colors.
#
# The flower in the middle of a ring. Booting, the ring fills with plymouth's estimate of
# the progress; shutting down, restarting or waking up, a piece of it sweeps round; the
# status sits underneath. A disk password (LUKS) shows as the lockscreen's pill, its dots
# popping in as they are typed. The ring is 240 small dots on a track, since a script
# splash cannot draw arcs; the flower breathes.

fun color(r, g, b) {
    c.r = r / 255;
    c.g = g / 255;
    c.b = b / 255;
    return c;
}

page = color({{tones.page|rgb}});
fg = color({{tones.text|rgb}});
dim = color({{tones.dim|rgb}});

Window.SetBackgroundTopColor(page.r, page.g, page.b);
Window.SetBackgroundBottomColor(page.r, page.g, page.b);

# The label plugin falls back to what the initramfs has when Rubik is not in it
FONT = "Rubik 12";

fun round(v) {
    if (v < 0)
        return -Math.Int(-v + 0.5);
    return Math.Int(v + 0.5);
}

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# The ring's middle, a little above the screen's
cx = screen_x + Math.Int(screen_w / 2);
cy = screen_y + Math.Int(screen_h / 2) - 40;
RING_R = 70;
below = cy + RING_R + 34;

# ── The ring ─────────────────────────────────────────────────

track = Sprite(Image("track.png"));
track.SetPosition(cx - 76, cy - 76, 10);

N = 240;
dot = Image("dot.png");
i = 0;
while (i < N) {
    a = Math.Pi * 2 * i / N - Math.Pi / 2;
    dots[i] = Sprite(dot);
    dots[i].SetPosition(cx - 3 + round(Math.Cos(a) * RING_R), cy - 3 + round(Math.Sin(a) * RING_R), 11);
    dots[i].SetOpacity(0);
    i++;
}

# Filling: the dots up to `lit` show, following `shown`, which eases after `target`
global.lit = 0;
global.target = 0;
global.shown = 0;

fun light(n) {
    while (global.lit < n) {
        dots[global.lit].SetOpacity(1);
        global.lit++;
    }
    while (global.lit > n) {
        global.lit--;
        dots[global.lit].SetOpacity(0);
    }
}

# Sweeping: SWEEP_LEN dots after `head` show, one turn in 1.4 s at 50 frames a second
SWEEP_LEN = 50;
SWEEP_SPEED = N / 70;
global.head = 0;
global.sweeping = 0;

fun start_sweep() {
    light(0);
    k = 0;
    while (k < SWEEP_LEN) {
        dots[k].SetOpacity(1);
        k++;
    }
    global.head = SWEEP_LEN - 1;
    global.sweeping = 1;
}

fun stop_sweep() {
    k = 0;
    while (k < N) {
        dots[k].SetOpacity(0);
        k++;
    }
    global.lit = 0;
    global.sweeping = 0;
}

fun sweep_step() {
    ahead = global.head + SWEEP_SPEED;
    k = Math.Int(global.head) + 1;
    while (k <= Math.Int(ahead)) {
        dots[k % N].SetOpacity(1);
        dots[(k - SWEEP_LEN + N) % N].SetOpacity(0);
        k++;
    }
    # A whole number of turns back keeps the numbers small and the dots where they are
    if (ahead > N * 100)
        ahead = ahead - N * 100;
    global.head = ahead;
}

# ── The flower ───────────────────────────────────────────────

logo = Image("logo.png");
logo_sprite = Sprite();
logo_sprite.SetZ(12);
LOGO = 64;

fun breathe(tick) {
    # 1 → 1.08 → 1 every 2.4 s
    s = 1 + 0.04 * (1 - Math.Cos(Math.Pi * 2 * tick / 120));
    size = round(LOGO * s);
    logo_sprite.SetImage(logo.Scale(size, size));
    logo_sprite.SetPosition(cx - Math.Int(size / 2), cy - Math.Int(size / 2), 12);
}
breathe(0);

# ── Status line ──────────────────────────────────────────────

status = Sprite();
status.SetZ(10);

fun say(text, c, y) {
    image = Image.Text(text, c.r, c.g, c.b, 1, FONT);
    status.SetImage(image);
    status.SetPosition(cx - Math.Int(image.GetWidth() / 2), y, 10);
}

# ── The disk password pill ───────────────────────────────────

PILL_W = 340;
PILL_H = 54;
pill_x = cx - Math.Int(PILL_W / 2);
pill_y = below - 6;
prompt_y = pill_y + PILL_H + 14;

pill = Sprite(Image("pill.png"));
pill.SetPosition(pill_x, pill_y, 20);
lock = Sprite(Image("lock.png"));
lock.SetPosition(pill_x + 18, pill_y + 16, 21);
go = Sprite(Image("go.png"));
go.SetPosition(pill_x + PILL_W - 48, pill_y + 6, 21);
entry = Sprite();
entry.SetPosition(pill_x + 52, pill_y + 17, 21);

# Dots: as many as fit between the lock and the go button
bullet = Image("bullet.png");
BULLETS = 15;
BULLET_X = pill_x + 52;
j = 0;
while (j < BULLETS) {
    bullets[j] = Sprite();
    bullets[j].SetZ(21);
    global.pops[j] = 1;
    j++;
}
global.typed = 0;

fun show_pill(on) {
    pill.SetOpacity(on);
    lock.SetOpacity(on);
    go.SetOpacity(on);
}
show_pill(0);

fun set_bullets(n) {
    if (n > BULLETS)
        n = BULLETS;
    while (global.typed < n) {
        global.pops[global.typed] = 0;
        bullets[global.typed].SetOpacity(1);
        global.typed++;
    }
    while (global.typed > n) {
        global.typed--;
        bullets[global.typed].SetOpacity(0);
    }
}

# A new dot grows past its size and settles (ease-out-back), like the lockscreen's spring
fun pop_step() {
    k = 0;
    while (k < global.typed) {
        p = global.pops[k];
        if (p < 1) {
            p = p + 0.16;
            if (p > 1)
                p = 1;
            global.pops[k] = p;
            t = p - 1;
            s = 1 + t * t * (2.7 * t + 1.7);
            size = round(10 * s);
            if (size < 1)
                size = 1;
            bullets[k].SetImage(bullet.Scale(size, size));
            bullets[k].SetPosition(BULLET_X + k * 15 + 5 - Math.Int(size / 2), pill_y + 27 - Math.Int(size / 2), 21);
        }
        k++;
    }
}

# ── Modes ────────────────────────────────────────────────────

# The same splash shows at boot, shutdown, restart, updates and waking up
mode = Plymouth.GetMode();
if (mode == "shutdown")
    state_text = "shutting down";
else if (mode == "reboot")
    state_text = "restarting";
else if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade")
    state_text = "installing updates";
else if (mode == "resume")
    state_text = "waking up";
else if (mode == "suspend")
    state_text = "going to sleep";
else
    state_text = "starting";
say(state_text, dim, below);

# Only booting has a progress (plymouth estimates it from the last boots); the rest sweep
# until an update reports how far it is
if (mode != "boot")
    start_sweep();

fun progress_callback(duration, progress) {
    global.target = progress;
}
Plymouth.SetBootProgressFunction(progress_callback);

fun update_callback(progress) {
    if (global.sweeping)
        stop_sweep();
    global.target = progress / 100;
    say(state_text + " · " + Math.Int(progress) + "%", dim, below);
}
Plymouth.SetSystemUpdateFunction(update_callback);

global.tick = 0;
fun refresh_callback() {
    global.tick++;
    breathe(global.tick % 120);
    if (global.sweeping) {
        sweep_step();
    } else {
        global.shown = global.shown + (global.target - global.shown) * 0.06;
        light(round(global.shown * N));
    }
    pop_step();
}
Plymouth.SetRefreshFunction(refresh_callback);

# ── Messages and questions ───────────────────────────────────

global.asking = 0;

fun message_callback(text) {
    if (global.asking == 0)
        say(text, dim, below);
}
Plymouth.SetDisplayMessageFunction(message_callback);

fun hide_message_callback(text) {
    if (global.asking == 0)
        say(state_text, dim, below);
}
Plymouth.SetHideMessageFunction(hide_message_callback);

fun password_callback(prompt, count) {
    global.asking = 1;
    show_pill(1);
    entry.SetOpacity(0);
    set_bullets(count);
    if (prompt == "")
        prompt = "disk password";
    say(prompt, dim, prompt_y);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

# Answers that may be seen (a key file's name, a yes or no) are written into the pill
fun question_callback(prompt, answer) {
    global.asking = 1;
    show_pill(1);
    set_bullets(0);
    entry.SetImage(Image.Text(answer, fg.r, fg.g, fg.b, 1, FONT));
    entry.SetOpacity(1);
    say(prompt, dim, prompt_y);
}
Plymouth.SetDisplayQuestionFunction(question_callback);

fun normal_callback() {
    global.asking = 0;
    show_pill(0);
    set_bullets(0);
    entry.SetOpacity(0);
    say(state_text, dim, below);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

# Booted: the ring closes before the login screen takes over
fun quit_callback() {
    if (global.sweeping == 0)
        light(N);
    say("", dim, below);
}
Plymouth.SetQuitFunction(quit_callback);
