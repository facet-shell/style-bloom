[Plymouth Theme]
Name=frameshell
Description=frameshell boot splash in the bloom style ({{name}}): the flower in a ring that fills while booting and sweeps while shutting down, the disk password as a pill
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/frameshell
ScriptFile=/usr/share/plymouth/themes/frameshell/frameshell.script
